{
  "realm": "ucotest",
  "enabled": true,
  "displayName": "UCO · ucotest",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "DOCENTE",
        "description": "Registra calificaciones de sus grupos"
      },
      {
        "name": "ESTUDIANTE",
        "description": "Recibe calificaciones"
      }
    ]
  },
  "clients": [
    {
      "clientId": "ucotest-frontend",
      "name": "Frontend Vue",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${UCOTEST_URL_PUBLICA}/*"
      ],
      "webOrigins": [
        "${UCOTEST_URL_PUBLICA}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${UCOTEST_URL_PUBLICA}/*"
      }
    }
  ],
